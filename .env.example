# Copiá este archivo a .env y completá los valores reales.
# El .env nunca se sube al repo (está en .gitignore).

# Clave secreta para firmar las cookies de sesión.
# Generá una nueva con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY= 2f52ad5a37c0de03f06bdd22e9ce6c26410b116f0b5e2e7ba22d610f7d56b276

# Conexión a MySQL (XAMPP / WAMP / Laragon traen MySQL + phpMyAdmin)
# Valores por defecto de XAMPP: usuario root, sin contraseña, puerto 3306.
# Si tenés conflicto de puerto (otro MySQL corriendo), XAMPP suele usar 3307.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=turnosalud

# Modo de Flask: development o production
FLASK_ENV=development
