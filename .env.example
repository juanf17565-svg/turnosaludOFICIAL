# Copiá este archivo a .env y completá los valores reales.
# El .env nunca se sube al repo (está en .gitignore).

# Clave secreta para firmar las cookies de sesión.
# Generá una nueva con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cambiame-en-produccion

# Conexión a MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=turnosalud

# Modo de Flask: development o production
FLASK_ENV=development
